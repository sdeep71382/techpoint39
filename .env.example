# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# Verify the result at any time with:  npm run check:email
# ---------------------------------------------------------------------------

# Resend API key: https://resend.com/api-keys  -> "Sending access" is enough.
# Must be the real re_... token. A placeholder left here makes the form fail.
RESEND_API_KEY=re_your_resend_api_key

# Who the message comes from.
#
# onboarding@resend.dev works on a free account but ONLY delivers to the inbox
# that owns the API key. Send to any other address and Resend rejects it.
# For real submissions verify a domain (https://resend.com/domains), add the
# DNS records it gives you, wait for "verified", then use it here:
#   FROM_EMAIL=Tech Point Services <hello@yourdomain.com>
FROM_EMAIL=Tech Point Services <onboarding@resend.dev>

# Where contact form submissions land. Any address you can read.
CONTACT_EMAIL=
