# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# Verify the result at any time with:  npm run check:email
# ---------------------------------------------------------------------------

# Resend API key: https://resend.com/api-keys  -> "Sending access" is enough.
# Must be the real re_... token. A placeholder left here makes the form fail.
RESEND_API_KEY=re_your_resend_api_key

# Who the message comes from.
#
# onboarding@resend.dev works, but it is Resend's shared free-tier domain.
# Gmail treats it as an unverified bulk sender: messages are usually accepted
# (Resend reports "delivered") yet land in Spam or a filtered tab rather than
# the Primary inbox. The form still shows success, so enquiries go quiet.
#
# Fix it by verifying the domain you already own:
#   1. https://resend.com/domains -> Add Domain -> techpointservices.in
#   2. Add the DNS records it gives you (SPF, DKIM) at your DNS host
#   3. Wait for the status to read "verified"
#   4. Set FROM_EMAIL below, then redeploy on Vercel
#
# With your own domain, SPF/DKIM/DMARC align, mail reaches the Primary inbox,
# and the sender reads "Tech Point Services <hello@techpointservices.in>"
# instead of "Resend <onboarding@resend.dev>".
FROM_EMAIL=Tech Point Services <onboarding@resend.dev>

# Where contact form submissions land. Any address you can read.
#
# Note: while FROM_EMAIL is onboarding@resend.dev, Resend only permits delivery
# to the inbox that owns the API key. Pointing this anywhere else stops all
# mail. Verify a domain to lift that restriction.
CONTACT_EMAIL=
