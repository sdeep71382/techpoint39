# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local.
# Verify the result at any time with:  npm run check:email
# ---------------------------------------------------------------------------

# Resend API key: https://resend.com/api-keys  -> "Sending access" is enough.
# Must be the real re_... token. A placeholder left here makes the form fail.
RESEND_API_KEY=re_your_resend_api_key

# Who the message comes from.
#
# techpointservices.in is verified in Resend, so this sends from the site's own
# domain. If you ever need to change the sender, verify the new domain at
# https://resend.com/domains and wait for "verified" first.
#
# The fallback, onboarding@resend.dev, is Resend's shared free-tier domain and
# is a trap in two ways: Gmail files its mail in Spam rather than the Primary
# inbox, and Resend only permits it to deliver to the inbox that owns the API
# key, so repointing CONTACT_EMAIL makes every send fail with a 403.
FROM_EMAIL=Tech Point Services <hello@techpointservices.in>

# Where contact form submissions land. Any address you can read.
CONTACT_EMAIL=techpointservices39@gmail.com
